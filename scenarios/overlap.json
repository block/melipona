      "expect": {"min_words": 40}
    },
    {
      "name": "interruption",
      "text": "Describe an imaginary garden in one paragraph of about eighty words.",
      "overlap": {"pcm": "fixtures/correction.pcm", "after_played_ms": 1024, "expect_clear": true},
      "expect": {"contains": ["six"], "max_stop_ms": 400}
    }
  ]
}
