{
  "name": "backchannel-and-floor-taking",
  "rounds": 5,
  "session": {
    "type": "realtime",
    "output_modalities": ["audio"],
    "max_output_tokens": 512,
    "audio": {"input": {"turn_detection": {"type": "server_vad", "create_response": true, "interrupt_response": true}}}
  },
  "turns": [
